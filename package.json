{
  "name": "simple-sound-editor",
  "version": "1.0.1",
  "description": "simple sound editor action event system",
  "keywords": [],
  "homepage": "https://github.com/simba-io/simple-sound-editor#readme",
  "bugs": {
    "url": "https://github.com/simba-io/simple-sound-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simba-io/simple-sound-editor.git"
  },
  "license": "ISC",
  "author": "cortec",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.css"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-css.cjs",
    "watch:ts": "tsc --watch --preserveWatchOutput",
    "watch:css": "chokidar \"src/**/*.css\" -c \"node scripts/copy-css.cjs\"",
    "build:watch": "npm run build && concurrently \"npm run watch:ts\" \"npm run watch:css\"",
    "prepare": "npm run build",
    "link:global": "npm run build && npm link",
    "unlink:global": "npm unlink",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@pixi/react": "^8.0.4",
    "@types/signals": "^1.0.4",
    "pixi.js": "^8.8.1",
    "tone": "^15.1.22"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
